{
  "firestore": {
    "database": "(default)",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "firebase-debug.*.log.*"
      ]
    }
  ],
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "school-app-backend-38e01",
          "appId": "1:601113409800:android:a85f2a88dc05a4a54d14bd",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "school-app-backend-38e01",
          "configurations": {
            "android": "1:601113409800:android:a85f2a88dc05a4a54d14bd",
            "web": "1:601113409800:web:543470df04f660464d14bd"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/app/**",
        "destination": "/app/index.html"
      },
      {
        "source": "/apply/**",
        "destination": "/apply/index.html"
      }
    ]
  }
}
